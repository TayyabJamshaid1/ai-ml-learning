  let n=arr.length;
for (let i=0;i<n-1;i++){
  //find minimum element in the array
  let min=i
   for (let j=i+1;j<n;j++){
     if (arr[j]<arr[min]){
     
       min=j
   }}
  //if array is already sorted,then not need to swap same elements
  if (arr[i]!=arr[min]){
     //adjust the swapping
 let temp=arr[i]
     arr[i]=arr[min]
     arr[min]=temp
  }
 
}
